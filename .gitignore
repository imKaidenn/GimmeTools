# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Local venv (built by install/setup.py)
tools/venv/

# Bundled binaries (downloaded per-machine — too large for a repo)
tools/ffmpeg/*
!tools/ffmpeg/.gitkeep
tools/realesrgan/
tools/handbrake/
tools/topaz/

# Models (downloaded on first use)
models/*
!models/.gitkeep

# Per-machine output
outputs/*
!outputs/tmp/
outputs/tmp/*
!outputs/tmp/.gitkeep
logs/*
!logs/.gitkeep

# User config (generated by setup.py / the app)
config.json
config/local.*
config/ui-state.json
config/presets.json

# Runtime data (job history) and release builds
data/
build/
dist/
*.spec

# Local tooling
.claude/

# OS / editor
Thumbs.db
.DS_Store
*.log
*.swp
.idea/
.vscode/
